@model IEnumerable<CookiEnDotNet.Models.Compra>

@{
    ViewData["Title"] = "Mis Compras";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Historial de Compras</h2>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-cart-plus me-1"></i> Nueva Compra
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-5" role="alert">
            <h4 class="alert-heading fw-bold mb-3">Todavia no tenes compras registradas</h4>
            <p class="mb-0">Parece que tu historial está vacío</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Nro. de Compra</th>
                                <th>Fecha y Hora</th>
                                <th class="text-center">Cant. Artículos</th>
                                <th class="text-end pe-4">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var compra in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">
                                        <a asp-action="Detalle" asp-route-id="@compra.NroCompra" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> #@compra.NroCompra.ToString("D6")
                                        </a>
                                        #@compra.NroCompra.ToString("D6")
                                    </td>
                                    <td>
                                        @compra.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <!-- Contamos la cantidad total de unidades compradas en ese pedido -->
                                    <td class="text-center">
                                        @compra.Detalles.Sum(d => d.Cantidad) unidades
                                    </td>
                                    <td class="text-end pe-4 fw-bold text-success">
                                        @compra.TotalCompra.ToString("C")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>