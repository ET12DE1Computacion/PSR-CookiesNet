@model CookiEnDotNet.Models.Compra

@{
    ViewData["Title"] = "¡Compra Exitosa!";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-success">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0">
                        <!-- Icono de Bootstrap (requiere bootstrap-icons en tu _Layout) -->
                        <i class="bi bi-check-circle-fill me-2"></i>¡Compra Realizada con Éxito!
                    </h3>
                </div>
                
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Comprobante Nro:</p>
                            <!-- El formato "D6" rellena con ceros a la izquierda (ej: 000001) -->
                            <h5 class="fw-bold">#@Model.NroCompra.ToString("D6")</h5>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <p class="mb-1 text-muted">Fecha y Hora:</p>
                            <h5 class="fw-bold">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</h5>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="mb-1 text-muted">Cliente:</p>
                        <h5 class="fw-bold text-primary">@Model.Cliente.NombreUsuario</h5>
                    </div>

                    <h5 class="border-bottom pb-2 mb-3">Detalle de la Compra</h5>
                    
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in Model.Detalles)
                                {
                                    <tr>
                                        <td>@detalle.NombreProducto</td>
                                        <td class="text-center">@detalle.Cantidad</td>
                                        <td class="text-end">@detalle.PrecioUnitario.ToString("C")</td>
                                        <!-- Calculamos el subtotal en tiempo real en la vista -->
                                        <td class="text-end fw-semibold">
                                            @((detalle.PrecioUnitario * detalle.Cantidad).ToString("C"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-group-divider">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold fs-5">Total Abonado:</td>
                                    <!-- Utilizamos la propiedad calculada TotalCompra de tu modelo -->
                                    <td class="text-end fw-bold fs-4 text-success">
                                        @Model.TotalCompra.ToString("C")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                
                <div class="card-footer bg-light text-center py-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                        Volver al Inicio
                    </a>
                    <a asp-controller="Compras" asp-action="Crear" class="btn btn-outline-secondary">
                        Realizar otra compra
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>