@model Producto

@{
    ViewData["Title"] = "Detalle del Producto";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Productos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">@Model.Nombre</h3>
            <span class="badge bg-light text-dark fs-6">ID: #@Model.Id</span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3 fw-bold text-secondary">Descripción:</div>
                <div class="col-md-9">@Model.Descripcion</div>
            </div>

            <hr />

            <div class="row mb-3 align-items-center">
                <div class="col-md-3 fw-bold text-secondary">Precio Unitario:</div>
                <div class="col-md-9">
                    <span class="fs-4 fw-bold text-success">
                        @Model.PrecioUnitario.ToString("C")
                    </span>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a la lista
            </a>
        </div>
    </div>
</div>