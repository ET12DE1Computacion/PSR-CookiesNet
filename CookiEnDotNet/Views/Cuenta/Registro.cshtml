@model Usuario

@{
    ViewData["Title"] = "Registro de Usuario";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">Crear una Cuenta</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Registro" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-group mb-3">
                            <label asp-for="NombreUsuario" class="form-label fw-bold">Nombre de Usuario</label>
                            <input asp-for="NombreUsuario" class="form-control" placeholder="Ej: lParedes5" autocomplete="username" />
                            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Rol" class="form-label fw-bold">Tipo de Rol</label>
                            <select asp-for="Rol" class="form-select">
                                <option value="Cliente">Cliente</option>
                                <option value="Administrador">Administrador</option>
                            </select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Registrarse</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center bg-light">
                    <span class="text-muted">¿Ya tienes una cuenta?</span>
                    <a asp-action="Login" class="text-decoration-none fw-bold ms-1">Iniciar Sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Scripts de validación en el cliente -->
    <partial name="_ValidationScriptsPartial" />
}